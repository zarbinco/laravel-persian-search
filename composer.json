{
    "name": "zarbinco/laravel-persian-search",
    "description": "Persian-aware search indexing, query expansion, wrong-keyboard typing correction, and relevance tools for Laravel, powered by laravel-persian-core.",
    "type": "library",
    "keywords": [
        "eloquent",
        "farsi",
        "farsi-search",
        "indexing",
        "iran",
        "laravel",
        "laravel-package",
        "persian",
        "persian-search",
        "query-expansion",
        "search"
    ],
    "homepage": "https://github.com/zarbinco/laravel-persian-search",
    "license": "MIT",
    "authors": [
        {
            "name": "Zarbinco",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/zarbinco/laravel-persian-search/issues",
        "source": "https://github.com/zarbinco/laravel-persian-search"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "zarbinco/laravel-persian-core": "dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Zarbinco\\PersianSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zarbinco\\PersianSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zarbinco\\PersianSearch\\PersianSearchServiceProvider"
            ],
            "aliases": {
                "PersianSearch": "Zarbinco\\PersianSearch\\Facades\\PersianSearch"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": [
            "composer validate --strict",
            "composer format -- --test",
            "composer analyse",
            "composer test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
